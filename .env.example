# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
#   cp .env.example .env
#   openssl rand -hex 32          # generate POSTGRES_PASSWORD
#
# Use -hex, NOT -base64. The base64 alphabet includes '/' and '+', and a '/' in
# a password silently breaks any postgresql://user:pass@host/db URL: the '/'
# ends the URL authority, so the driver reads part of the password as the
# hostname and fails with "Servname not supported for ai_socktype".
# The compose stack avoids URLs entirely (it passes PGPASSWORD), but anything
# else you paste this password into - psql, a GUI client, an app config - will
# hit that trap. -hex sidesteps it permanently.

POSTGRES_DB=ck_pincode
POSTGRES_USER=ck
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Free key from https://data.gov.in/user/register -> My Account -> API key.
# Needed by `etl fetch` and `etl refresh`; the build works without it.
DATA_GOV_KEY=

# --- web interface -----------------------------------------------------------
# Where the UI listens. 127.0.0.1 (default) means loopback only: reach it with
# an SSH tunnel, `ssh -L 8000:localhost:8000 user@vps`. Set 0.0.0.0 to publish
# it on the public IP - only behind a firewall or a TLS reverse proxy, because
# the read endpoints have no authentication.
# CK_WEB_BIND=0.0.0.0
# CK_WEB_PORT=8000

# Enables the Operations tab (run build / localities / export / refresh from the
# browser). Leave EMPTY and /api/admin/* does not exist at all - the tab then
# shows pipeline status only, which is the safe default.
# Anyone with this token can modify the master. Generate one with:
#   openssl rand -hex 32
# and never set it on a service exposed without TLS.
CK_ADMIN_TOKEN=

# Used when running the pipeline OUTSIDE docker (e.g. on your laptop against the
# VPS through an SSH tunnel: ssh -L 5432:localhost:5432 user@vps).
# Leave unset locally and the pipeline defaults to sqlite:///out/ck_pincode.db.
#
# Safest form - no password in the URL at all:
#   CK_DB_URL=postgresql://
#   PGHOST=localhost
#   PGPORT=5432
#   PGUSER=ck
#   PGPASSWORD=<your password, any characters>
#   PGDATABASE=ck_pincode
#
# Or inline, but then every reserved character must be percent-encoded
# ('/'->%2F, '@'->%40, ':'->%3A, '+'->%2B, '#'->%23):
#   CK_DB_URL=postgresql://ck:password@localhost:5432/ck_pincode
